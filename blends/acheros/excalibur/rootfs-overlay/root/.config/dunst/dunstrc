[global]
    font = "gomono"
    markup = full
    format = "%s\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    line_height = 0
    separator_height = 1
    padding = 4
    horizontal_padding = 4
    separator_color = "#8b008b"
    frame_width = 1
    frame_color = "#ff00ff"

[urgency_low]
    background = "#000000"
    foreground = "#ff00ff"
    timeout = 10

[urgency_normal]
    background = "#000000"
    foreground = "#ff00ff"
    timeout = 30

[urgency_critical]
    background = "#000000"
    foreground = "#ff00ff"
timeout = 0
